{
  "name": "my-storytelling-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-typescript-tests.cjs",
    "baseline:counts": "node scripts/baseline-counts.mjs",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:check-empty": "node scripts/run-typescript-tests.cjs scripts/check-empty-database.ts",
    "test:db": "node --conditions=react-server scripts/run-typescript-tests.cjs src/__tests__/database.integration.ts",
    "test:auth:db": "node --conditions=react-server scripts/run-typescript-tests.cjs src/__tests__/auth.integration.ts",
    "test:auth:http": "node --conditions=react-server scripts/run-typescript-tests.cjs src/__tests__/auth-http.integration.ts",
    "auth:bootstrap-admin": "node --conditions=react-server scripts/run-typescript-tests.cjs scripts/bootstrap-admin.ts",
    "migrate:phase3": "node --conditions=react-server scripts/run-typescript-tests.cjs scripts/migrate-phase3.ts",
    "test:migration:db": "node --conditions=react-server scripts/run-typescript-tests.cjs src/__tests__/phase3-migration.integration.ts",
    "test:reads:db": "node --conditions=react-server scripts/run-typescript-tests.cjs src/__tests__/p3-05-read.integration.ts",
    "test:commands:db": "node --conditions=react-server scripts/run-typescript-tests.cjs src/__tests__/p3-06-commands.integration.ts",
    "test:commands:http": "node --conditions=react-server scripts/run-typescript-tests.cjs src/__tests__/p3-06-http.integration.ts",
    "test:client-bundle": "node scripts/check-client-bundle.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@next/env": "16.3.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@studio-freight/lenis": "^1.0.42",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/howler": "^2.2.13",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma"]
  }
}
