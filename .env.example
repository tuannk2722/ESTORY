# Copy to .env.local. Keep real credentials out of git.
# Use a separate Neon branch/database for each development, preview and production environment.
# DATABASE_URL: pooled endpoint for the application (hostname contains -pooler).
# DIRECT_URL: direct endpoint for Prisma CLI, pointing to the SAME branch/database.
# Paste the exact URLs from Neon, including SSL/channel-binding query parameters.
DATABASE_URL=
DIRECT_URL=

# Optional: dedicated disposable shadow database for migrate dev when the role
# cannot create databases. This MUST NOT point to any application database.
SHADOW_DATABASE_URL=

# P3-02 keeps JSON persistence. Prisma/shadow values are rejected until their stages.
PHASE3_STORY_READ_SOURCE=json
PHASE3_STORY_WRITE_SOURCE=json
PHASE3_SCENE_READ_SOURCE=json
PHASE3_SHADOW_READ=false
