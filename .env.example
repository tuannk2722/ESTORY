# Copy to .env.local. Keep real credentials out of git.
# Use a separate Neon branch/database for each development, preview and production environment.
# DATABASE_URL: pooled endpoint for the application (hostname contains -pooler).
# DIRECT_URL: direct endpoint for Prisma CLI, pointing to the SAME branch/database.
# Paste the exact URLs from Neon, including SSL/channel-binding query parameters.
DATABASE_URL=
DIRECT_URL=

# Optional: dedicated disposable shadow database for migrate dev when the role
# cannot create databases. This MUST NOT point to any application database.
SHADOW_DATABASE_URL=

# Auth.js (P3-03). Generate AUTH_SECRET from at least 32 random bytes.
# Use separate OAuth applications/secrets and AUTH_URL per environment.
# AUTH_URL is an origin: HTTPS outside localhost; no path/query/credentials.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Server-side CLI only. Comma-separated exact selectors; no wildcard matching.
# Targets must sign in first. Bootstrap promotes existing users, never creates them.
BOOTSTRAP_ADMIN_EMAILS=
BOOTSTRAP_ADMIN_USER_IDS=

# P3-04 migration CLI only. Exact existing User.id that will own all legacy stories.
# This is not inferred from the display-name string stored in legacy JSON.
LEGACY_OWNER_USER_ID=

# Read selectors default to JSON; Prisma/shadow reads require DATABASE_URL.
# P3-06: write=json disables runtime content writes (no JSON fallback).
# write=prisma requires both read sources=prisma. Keep production writes off until P3-07.
PHASE3_STORY_READ_SOURCE=json
PHASE3_STORY_WRITE_SOURCE=json
PHASE3_SCENE_READ_SOURCE=json
PHASE3_SHADOW_READ=false
